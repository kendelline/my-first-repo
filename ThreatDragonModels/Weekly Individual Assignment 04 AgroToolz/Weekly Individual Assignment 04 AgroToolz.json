              "type": "tm.Process",
              "name": "Fitur Web Apps:\nMengelola \nPenyewaan & \nAppointment \ndengan Ahli \nAgroToolz",
              "description": "",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "a11a517b-a91e-48e4-a7cc-ef28cf2f1f82",
                  "title": "CSRF Attack/Token",
                  "status": "Open",
                  "severity": "TBA",
                  "type": "Tampering",
                  "description": "Sistem tidak memiliki CSRF token untuk memverifikasi permintaan pengguna yang sah.",
                  "mitigation": "1. Gunakan CSRF Token di setiap request sensitif.\n2. Validasi CSRF Token di backend sebelum memproses request.\n3. Periksa Referer Header untuk memastikan permintaan berasal dari domain sah.\n4. Gunakan SameSite Cookies agar cookie hanya dikirim dalam request dari situs yang sama.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "40843b7f-8ba7-4770-9438-49a3620f7b45",
                  "title": "SQL Injection",
                  "status": "Open",
                  "severity": "TBA",
                  "type": "Elevation of privilege",
                  "description": "Input pengguna tidak difilter dengan baik, memungkinkan attacker menyisipkan perintah SQL berbahaya.",
                  "mitigation": "1. Gunakan Parameterized Queries agar input tidak langsung dieksekusi sebagai SQL.\n2. Validasi dan Escape Input untuk menghindari karakter berbahaya.\n3. Batasi Hak Akses Database agar hanya bisa membaca atau menulis data yang dibutuhkan.\n4. Gunakan Web Application Firewall (WAF) untuk mendeteksi dan memblokir serangan SQLi.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "908e7e7b-cbbe-4d09-b89e-632b13dccfa8",
                  "title": "Session Hijacking",
                  "status": "Open",
                  "severity": "TBA",
                  "type": "Spoofing",
                  "description": "Sistem tidak menerapkan secure flag dan HTTPOnly cookies, sehingga attacker dapat mencuri session pengguna melalui serangan XSS atau MITM (Man-in-the-Middle).",
                  "mitigation": "1. Gunakan Secure & HTTPOnly Flag pada cookies untuk mencegah akses dari JavaScript.\n2. Aktifkan HTTPS untuk mengenkripsi komunikasi dan mencegah Man-in-the-Middle attack.\n3. Gunakan Session Timeout agar sesi pengguna otomatis berakhir setelah waktu tertentu.\n4. Implementasi Multi-Factor Authentication (MFA) untuk menambah lapisan keamanan login.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                }
              ],
